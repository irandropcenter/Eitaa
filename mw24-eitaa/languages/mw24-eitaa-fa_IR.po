msgid "%1$s of %2$s users processed — %3$s users updated, %4$s values written, %5$s skipped."
msgstr "%1$s از %2$s کاربر بررسی شد — %3$s کاربر به‌روزرسانی شد، %4$s مقدار نوشته شد، %5$s مورد رد شد."

msgid "Scanned %1$s users: %2$s have a phone, %3$s would be updated (%4$s values), %5$s skipped because of conflicts."
msgstr "%1$s کاربر بررسی شد: %2$s کاربر شماره دارند، %3$s کاربر به‌روزرسانی می‌شوند (%4$s مقدار) و %5$s مورد به‌دلیل تداخل رد می‌شود."

msgid "This message would be queued for %s users."
msgstr "این پیام برای %s کاربر در صف قرار می‌گیرد."

msgid "You do not have permission to do this."
msgstr "شما اجازهٔ انجام این کار را ندارید."

msgid "Settings saved."
msgstr "تنظیمات ذخیره شد."

msgid "The Eitaa account was disconnected."
msgstr "اتصال حساب ایتا قطع شد."

msgid "The log was cleared."
msgstr "لاگ پاک شد."

msgid "Queue processed: %1$d sent, %2$d failed."
msgstr "صف پردازش شد: %1$d ارسال موفق، %2$d ناموفق."

msgid "%d failed messages were put back in the queue."
msgstr "%d پیام ناموفق دوباره به صف برگشت."

msgid "Sent and failed messages were removed from the queue."
msgstr "پیام‌های ارسال‌شده و ناموفق از صف حذف شدند."

msgid "The message queue was emptied."
msgstr "صف پیام خالی شد."

msgid "Cached data was cleared."
msgstr "داده‌های کش‌شده پاک شد."

msgid "All settings were reset to their defaults. The token and phone maps were kept."
msgstr "همهٔ تنظیمات به حالت پیش‌فرض برگشت. توکن و نقشه‌های شماره حفظ شدند."

msgid "The app token was deleted."
msgstr "توکن برنامه حذف شد."

msgid "%d messages were added to the queue."
msgstr "%d پیام به صف اضافه شد."

msgid "Unknown action."
msgstr "عملیات ناشناخته."

msgid "Eitaa Connect: the saved app token can no longer be decrypted (the site security keys changed). Please enter the token again."
msgstr "اتصال به ایتا: توکن ذخیره‌شده دیگر قابل رمزگشایی نیست (کلیدهای امنیتی سایت تغییر کرده است). لطفاً توکن را دوباره وارد کنید."

msgid "Connection settings"
msgstr "تنظیمات اتصال"

msgid "Eitaa Connect is installed but not connected yet."
msgstr "افزونهٔ اتصال به ایتا نصب شده اما هنوز متصل نیست."

msgid "Start setup"
msgstr "شروع راه‌اندازی"

msgid "Auto-detected login plugins: %s. Please review and confirm the phone sync profile."
msgstr "افزونه‌های ورود شناسایی‌شده: %s. لطفاً پروفایل همگام‌سازی شماره را بررسی و تأیید کنید."

